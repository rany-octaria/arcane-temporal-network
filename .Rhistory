#     - exact variant agreement
#     - facility name, TWO TIERS (tier 1 preferred):
#         tier 1  CNR facility_name  vs  BHRe facility_name_capact   (name<->name)
#         tier 2  CNR facility_name  vs  BHRe city                   (name<->city)
#       e.g. CNR "Bayonne - Cote Basque": tier1 hits on BASQUE (vs "CH BASQUE"),
#            tier2 hits on BAYONNE (vs city "Bayonne").
#     - department (derived from FINESS geographique)
#     - exact submission month
#
# Point this at your object:
bhre <- bhre_cut
#     - exact variant agreement
#     - facility name, TWO TIERS (tier 1 preferred):
#         tier 1  CNR facility_name  vs  BHRe facility_name_capact   (name<->name)
#         tier 2  CNR facility_name  vs  BHRe city                   (name<->city)
#       e.g. CNR "Bayonne - Cote Basque": tier1 hits on BASQUE (vs "CH BASQUE"),
#            tier2 hits on BAYONNE (vs city "Bayonne").
#     - department (derived from FINESS geographique)
#     - exact submission month
#
# Point this at your object:
bhre <- readRDS(here("Datasets", "Sante Publique", "Cleaned", "bhre_2024_hosp.RDS"))
cnr  <- read_excel(here("Datasets", "Output Data", "CNR_2023_2024_DEIDENTIFIED_shareable_EN_clean.xlsx")
cnr  <- read_excel(here("Datasets", "Output Data", "CNR_2023_2024_DEIDENTIFIED_shareable_EN_clean.xlsx"))
library(dplyr); library(tidyr); library(stringr); library(purrr)
cnr  <- read_excel(here("Datasets", "Output Data", "CNR_2023_2024_DEIDENTIFIED_shareable_EN_clean.xlsx"))
library(dplyr); library(tidyr); library(stringr); library(purrr)
library(lubridate); library(stringi)
tol_months <- 1L
EPC_LAB <- "CNR des ent\u00e9robact\u00e9ries productrices de carbap\u00e9n\u00e8mases (EPC) au Kremlin-Bic\u00eatre"
# ----------------------------------------------------------------------------
# 0. Helpers
# ----------------------------------------------------------------------------
ym_int        <- function(y, m) as.integer(y) * 12L + as.integer(m)
strip_accents <- function(x) stri_trans_general(as.character(x), "Latin-ASCII")
has_overlap   <- function(a, b) length(intersect(a, b)) > 0
# FINESS geographique -> 2-digit department (pad to 9, strip trailing ".0")
fin_dept <- function(x) {
x <- str_replace(as.character(x), "\\.0$", "")
str_sub(str_pad(str_extract(x, "[0-9]+"), 9, pad = "0"), 1, 2)
}
# Carbapenemase gene FAMILY for a single token
oxa48_like <- c("OXA-48","OXA-48-LIKE","OXA-181","OXA-204","OXA-244","OXA-162",
"OXA-232","OXA-484","OXA-163","OXA-245","OXA-370","OXA-405")
carb_family_one <- function(x) {
x <- toupper(trimws(x))
if (is.na(x) || x == "" || x == "-") return(NA_character_)
if (x %in% oxa48_like || str_starts(x, "OXA-48")) return("OXA48")
if (str_starts(x, "KPC")) return("KPC")
if (str_starts(x, "NDM")) return("NDM")
if (str_starts(x, "VIM")) return("VIM")
if (str_starts(x, "IMP")) return("IMP")
if (str_starts(x, "IMI")) return("IMI")
if (str_starts(x, "GES")) return("GES")
NA_character_
}
families_of <- function(x) unique(na.omit(map_chr(str_trim(str_split(x, "\\+")[[1]]),
carb_family_one)))
variants_of <- function(x) unique(toupper(str_trim(str_split(x, "\\+")[[1]])))
species_canon <- function(x) {
x <- toupper(strip_accents(x))
case_when(
str_detect(x, "COLI")                 ~ "ECO",
str_detect(x, "PNEUMONIAE")           ~ "KPN",
str_detect(x, "CLOACAE|ENTEROBACTER") ~ "ECL",
str_detect(x, "AEROGENES")            ~ "KAE",
str_detect(x, "OXYTOCA")              ~ "KOX",
str_detect(x, "MARCESCENS|SERRATIA")  ~ "SMA",
is.na(x) | x == "" ~ NA_character_,
TRUE ~ str_extract(x, "^[A-Z]+")
)
}
# Place-name tokeniser: drops facility-type stopwords, keeps distinctive tokens
place_stop <- c("CH","CHU","CHR","CHG","CHIC","CHS","GH","GHT","HL","HOP","HOPITAL",
"HOPITAUX","CENTRE","HOSPITALIER","HOSPITALIERE","CLINIQUE","POLYCLINIQUE",
"GROUPE","GROUPEMENT","DE","DU","DES","LA","LE","LES","SUR","ET","SAINT","ST",
"STE","SAINTE","EHPAD","SSR","MCO","HAD","PSY")
tokenize_place <- function(x) {
x <- str_squish(str_replace_all(toupper(strip_accents(x)), "[^A-Z0-9]", " "))
map(str_split(x, " "), ~ unique(.x[nchar(.x) >= 3 & !.x %in% place_stop]))
}
mech_cols  <- c("resistance_mechanism_1_1","resistance_mechanism_1_2",
"resistance_mechanism_2_1","resistance_mechanism_2_2",
"resistance_mechanism_3_1","resistance_mechanism_3_2")
micro_cols <- c("microorganism_1","microorganism_2","microorganism_3")
# ----------------------------------------------------------------------------
# 1. BHRe side: EPC-referred episodes, keyed on family + submission month-year
# ----------------------------------------------------------------------------
bhre_prep <- bhre %>%
filter(cnr_referral == EPC_LAB) %>%
mutate(
submit_date   = as.Date(form_issue_date),
submit_ym     = ym_int(year(submit_date), month(submit_date)),
bhre_city     = coalesce(city.x, city.y),
bhre_dept     = fin_dept(facility_finess_code),
bhre_name_tok = tokenize_place(facility_name_capact),   # TIER 1 source
bhre_city_tok = tokenize_place(bhre_city),              # TIER 2 source
bhre_variants = pmap(select(., all_of(mech_cols)),
~ toupper(na.omit(unique(c(...))))),
bhre_families = map(bhre_variants, ~ unique(na.omit(map_chr(.x, carb_family_one)))),
bhre_species  = pmap(select(., all_of(micro_cols)),
~ unique(na.omit(species_canon(c(...)))))
) %>%
filter(!is.na(submit_ym), lengths(bhre_families) > 0)
bhre_keyed <- bhre_prep %>%
mutate(ym = map(submit_ym, ~ seq(.x - tol_months, .x + tol_months))) %>%
select(ehesp_id, submit_date, submit_ym, bhre_dept, bhre_city,
facility_name_capact, bhre_name_tok, bhre_city_tok,
bhre_variants, bhre_species, family = bhre_families, ym) %>%
unnest(family) %>%
unnest(ym)
# ----------------------------------------------------------------------------
# 2. CNR side: family + referral month-year (one row per family in a combo)
# ----------------------------------------------------------------------------
cnr_prep <- cnr %>%
filter(!is_environment %in% TRUE) %>%
mutate(
cnr_ym    = ym_int(2000L + as.integer(sample_year), as.integer(sample_month)),
cnr_dept  = coalesce(str_sub(str_extract(as.character(department_code), "[0-9]+"), 1, 2),
str_sub(str_extract(as.character(zip_code_facility), "[0-9]+"), 1, 2)),
cnr_spec  = species_canon(species),
cnr_name_tok = tokenize_place(facility_name),
cnr_variants = map(sequencing, variants_of),
family       = map(sequencing, families_of)
) %>%
filter(lengths(family) > 0, !is.na(cnr_ym)) %>%
unnest(family)
# ----------------------------------------------------------------------------
# 3. Backbone join: same family + submission month within +/-1 of referral
# ----------------------------------------------------------------------------
candidates <- bhre_keyed %>%
inner_join(cnr_prep, by = c("family", "ym" = "cnr_ym"),
relationship = "many-to-many") %>%
mutate(
month_exact   = ym == submit_ym,
variant_exact = map2_lgl(bhre_variants, cnr_variants, has_overlap),
dept_match    = !is.na(bhre_dept) & !is.na(cnr_dept) & bhre_dept == cnr_dept,
species_match = map2_lgl(bhre_species, cnr_spec, ~ !is.na(.y) && .y %in% .x),
# --- two-tier facility name (tier 1 preferred over tier 2) ---
name_t1 = map2_lgl(cnr_name_tok, bhre_name_tok, has_overlap),   # name <-> name
name_t2 = map2_lgl(cnr_name_tok, bhre_city_tok, has_overlap),   # name <-> city
name_tier  = case_when(name_t1 ~ "tier1_name",
name_t2 ~ "tier2_city",
TRUE    ~ NA_character_),
name_score = case_when(name_t1 ~ 3L, name_t2 ~ 2L, TRUE ~ 0L),
score = 2L*variant_exact + name_score + 1L*dept_match + 1L*month_exact,
confidence = case_when(
score >= 4 ~ "High",
score >= 2 ~ "Medium",
TRUE       ~ "Low"
) %>% factor(levels = c("High","Medium","Low")),
match_keys = pmap_chr(
list(variant_exact, name_tier, dept_match, month_exact),
function(v, nt, d, m) paste(c("family+month-window",
if (v) "variant",
if (!is.na(nt)) nt,
if (d) "dept",
if (m) "exact-month")[c(TRUE, v, !is.na(nt), d, m)], collapse = "+"))
)
# ----------------------------------------------------------------------------
# 4. Best CNR match per episode + ambiguity flag
# ----------------------------------------------------------------------------
best_matches <- candidates %>%
group_by(ehesp_id) %>%
mutate(top = score == max(score), n_tied_at_top = sum(top)) %>%
filter(top) %>% ungroup() %>%
transmute(
ehesp_id, patient_id, specimen_id,
confidence, score, name_tier, match_keys, n_tied_at_top,   # >1 => ambiguous
submit_date, family, cnr_sequencing = sequencing,
facility_name_capact, cnr_facility = facility_name,
bhre_city, bhre_dept, cnr_dept, cnr_species = cnr_spec
) %>%
arrange(desc(confidence), desc(score))
View(best_matches)
# ----------------------------------------------------------------------------
# 5. Report
# ----------------------------------------------------------------------------
n_epc <- sum(bhre$cnr_referral == EPC_LAB, na.rm = TRUE)
link_summary <- tibble(
metric = c("EPC-referred BHRe episodes",
"  ... keyed (submission date + carbapenemase family present)",
"  ... with >=1 CNR match",
"        High confidence",
"        Medium confidence",
"        Low confidence",
"        AMBIGUOUS (tied best match)",
"  ... best match carried by name tier 1 (name<->name)",
"  ... best match carried by name tier 2 (name<->city)",
"Distinct CNR specimens linked"),
n = c(n_epc,
n_distinct(bhre_keyed$ehesp_id),
n_distinct(best_matches$ehesp_id),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "High"]),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "Medium"]),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "Low"]),
n_distinct(best_matches$ehesp_id[best_matches$n_tied_at_top > 1]),
n_distinct(best_matches$ehesp_id[best_matches$name_tier %in% "tier1_name"]),
n_distinct(best_matches$ehesp_id[best_matches$name_tier %in% "tier2_city"]),
n_distinct(best_matches$specimen_id))
)
print(link_summary)
best_matches = best_matches %>% filter(confidence != "low")
View(best_matches)
best_matches = best_matches %>% filter(confidence != "Low")
View(best_matches)
# ----------------------------------------------------------------------------
# 4. Best CNR match per episode + ambiguity flag
# ----------------------------------------------------------------------------
best_matches <- candidates %>%
group_by(ehesp_id) %>%
mutate(top = score == max(score), n_tied_at_top = sum(top)) %>%
filter(top) %>% ungroup() %>%
transmute(
ehesp_id, patient_id, specimen_id,
confidence, score, name_tier, match_keys, n_tied_at_top,   # >1 => ambiguous
submit_date, sample_month, sample_year,
family, cnr_sequencing = sequencing,
facility_name_capact, cnr_facility = facility_name,
bhre_city, bhre_dept, cnr_dept, cnr_species = cnr_spec
) %>%
arrange(desc(confidence), desc(score))
best_matches = best_matches %>% filter(confidence != "Low")
colnames(bhre)
