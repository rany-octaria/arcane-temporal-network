write.csv(bhre_2024_hosp,  here("Datasets", "Sante Publique", "Cleaned", "bhre_2024_hosp.csv"))
write.csv(bhre_2024_hosp,  file =here("Datasets", "Sante Publique", "Cleaned", "bhre_2024_hosp.csv"))
