best_matches <- candidates %>%
group_by(ehesp_id) %>%
mutate(top = score == max(score),
n_tied_at_top = sum(top)) %>%
filter(top) %>%
ungroup() %>%
transmute(
ehesp_id, patient_id, specimen_id,
confidence, score, match_keys,
n_tied_at_top,                                   # >1 => ambiguous
bhre_start, cnr_ym_year = ym %/% 12, cnr_ym_month = ym %% 12,
family, cnr_sequencing = cnr_seq_u,
bhre_dept, cnr_dept,
cnr_species = cnr_spec, cnr_referred
) %>%
arrange(desc(confidence), desc(score))
# ----------------------------------------------------------------------------
# 5. Report
# ----------------------------------------------------------------------------
n_bhre_total <- n_distinct(bhre_prep$ehesp_id)
link_summary <- tibble(
metric = c("BHRe episodes (with usable date)",
"  ... unmatchable on mechanism (no family)",
"BHRe episodes with >=1 candidate",
"  ... best match High confidence",
"  ... best match Medium confidence",
"  ... best match Low confidence",
"  ... AMBIGUOUS (tied best match)",
"Distinct CNR specimens linked"),
n = c(
n_bhre_total,
n_distinct(bhre_no_family$ehesp_id),
n_distinct(best_matches$ehesp_id),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "High"]),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "Medium"]),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "Low"]),
n_distinct(best_matches$ehesp_id[best_matches$n_tied_at_top > 1]),
n_distinct(best_matches$specimen_id)
)
)
print(link_summary)
colnames(bhre_2024)
# ----------------------------------------------------------------------------
# 0. Helpers
# ----------------------------------------------------------------------------
parse_date_safe <- function(x) {
if (inherits(x, "Date"))    return(x)
if (inherits(x, "POSIXct")) return(as.Date(x))
suppressWarnings(as.Date(lubridate::parse_date_time(
as.character(x), orders = c("ymd", "dmy", "mdy", "Y-m-d", "d/m/Y"))))
}
ym_int        <- function(y, m) as.integer(y) * 12L + as.integer(m)
strip_accents <- function(x) iconv(x, to = "ASCII//TRANSLIT")
truthy <- function(x) toupper(strip_accents(as.character(x))) %in%
c("OUI", "YES", "TRUE", "1", "O", "Y")
# Carbapenemase gene FAMILY (backbone key); finer CNR variants collapse in.
oxa48_like <- c("OXA-48","OXA-48-LIKE","OXA-181","OXA-204","OXA-244","OXA-162",
"OXA-232","OXA-484","OXA-163","OXA-245","OXA-370","OXA-405")
carb_family <- function(x) {
x <- toupper(trimws(as.character(x)))
case_when(
is.na(x) | x == ""                          ~ NA_character_,
x %in% oxa48_like | str_starts(x, "OXA-48")  ~ "OXA48",
str_starts(x, "KPC") ~ "KPC",
str_starts(x, "NDM") ~ "NDM",
str_starts(x, "VIM") ~ "VIM",
str_starts(x, "IMP") ~ "IMP",
str_starts(x, "IMI") ~ "IMI",
str_starts(x, "GES") ~ "GES",
TRUE ~ NA_character_
)
}
species_canon <- function(x) {
x <- toupper(strip_accents(as.character(x)))
case_when(
str_detect(x, "COLI")                 ~ "ECO",
str_detect(x, "PNEUMONIAE")           ~ "KPN",
str_detect(x, "CLOACAE|ENTEROBACTER") ~ "ECL",
str_detect(x, "AEROGENES")            ~ "KAE",
str_detect(x, "OXYTOCA")              ~ "KOX",
str_detect(x, "MARCESCENS|SERRATIA")  ~ "SMA",
is.na(x) | x == "" ~ NA_character_,
TRUE ~ str_extract(x, "^[A-Z]+")
)
}
mech_cols  <- c("resistance_mechanism_1_1","resistance_mechanism_1_2",
"resistance_mechanism_2_1","resistance_mechanism_2_2",
"resistance_mechanism_3_1","resistance_mechanism_3_2")
micro_cols <- c("microorganism_1","microorganism_2","microorganism_3")
# ----------------------------------------------------------------------------
# 1. BHRe side: referred episodes, keyed on referral month-year + family
# ----------------------------------------------------------------------------
bhre_prep <- bhre_2024 %>%
mutate(
referral_date = parse_date_safe(cnr_referral_date),
cnr_referred  = truthy(cnr_referral),
bhre_dept     = str_sub(str_extract(as.character(department), "\\d+"), 1, 2),
bhre_variants = pmap(select(., all_of(mech_cols)),
~ toupper(na.omit(unique(c(...))))),
bhre_families = map(bhre_variants, ~ unique(na.omit(carb_family(.x)))),
bhre_species  = pmap(select(., all_of(micro_cols)),
~ unique(na.omit(species_canon(c(...)))))
) %>%
filter(!is.na(referral_date), lengths(bhre_families) > 0) %>%   # need date + family
mutate(referral_ym = ym_int(year(referral_date), month(referral_date)))
# Keyed rows: one per (episode x family). Family is the only list we unnest,
# because the month-year is a single value now (no window).
bhre_keyed <- bhre_prep %>%
select(ehesp_id, facility_finess_code, referral_date, referral_ym,
bhre_dept, region, cnr_referred, bhre_variants, bhre_species,
family = bhre_families) %>%
unnest(family)
# ----------------------------------------------------------------------------
# 2. CNR side: referral month-year + family
# ----------------------------------------------------------------------------
cnr_prep <- cnr %>%
filter(!is_environment %in% TRUE) %>%
mutate(
cnr_year  = 2000L + suppressWarnings(as.integer(sample_year)),
cnr_month = suppressWarnings(as.integer(sample_month)),
cnr_ym    = ym_int(cnr_year, cnr_month),
cnr_seq_u = toupper(trimws(sequencing)),
family    = carb_family(sequencing),
cnr_spec  = species_canon(species),
cnr_dept  = coalesce(str_sub(str_extract(as.character(department_code), "\\d+"), 1, 2),
str_sub(str_extract(as.character(zip_code_facility), "\\d+"), 1, 2))
) %>%
filter(!is.na(family), !is.na(cnr_ym))
# ----------------------------------------------------------------------------
# 3. Backbone join: same family + same referral month-year
# ----------------------------------------------------------------------------
candidates <- bhre_keyed %>%
inner_join(cnr_prep, by = c("family", "referral_ym" = "cnr_ym"),
relationship = "many-to-many") %>%
mutate(
variant_exact = map2_lgl(bhre_variants, cnr_seq_u, ~ .y %in% .x),
dept_match    = !is.na(bhre_dept) & !is.na(cnr_dept) & bhre_dept == cnr_dept,
species_match = map2_lgl(bhre_species, cnr_spec, ~ !is.na(.y) && .y %in% .x),
# corroboration weight: variant is the strongest single signal
corr = 2L * variant_exact + 1L * dept_match + 1L * species_match,
confidence = case_when(
variant_exact | (dept_match & species_match) ~ "High",
dept_match | species_match                   ~ "Medium",
TRUE                                          ~ "Low"
) %>% factor(levels = c("High", "Medium", "Low")),
match_keys = pmap_chr(
list(variant_exact, dept_match, species_match),
function(v, d, s) paste(c("family+month",
if (v) "variant", if (d) "dept",
if (s) "species")[c(TRUE, v, d, s)],
collapse = "+"))
)
# ----------------------------------------------------------------------------
# 4. Best CNR match per episode + ambiguity flag
# ----------------------------------------------------------------------------
best_matches <- candidates %>%
group_by(ehesp_id) %>%
mutate(top = corr == max(corr), n_tied_at_top = sum(top)) %>%
filter(top) %>%
ungroup() %>%
transmute(
ehesp_id, patient_id, specimen_id,
confidence, match_keys, n_tied_at_top,          # n_tied_at_top > 1 => ambiguous
referral_date, family, cnr_sequencing = cnr_seq_u,
bhre_dept, cnr_dept, cnr_species = cnr_spec, cnr_referred
) %>%
arrange(desc(confidence))
# ----------------------------------------------------------------------------
# 5. Report
# ----------------------------------------------------------------------------
n_referred <- bhre_2024 %>% filter(truthy(cnr_referral)) %>% nrow()
link_summary <- tibble(
metric = c("BHRe episodes flagged referred to CNR",
"BHRe referred episodes keyed (date + family present)",
"  ... with >=1 CNR match",
"      High confidence",
"      Medium confidence",
"      Low confidence",
"      AMBIGUOUS (tied best match)",
"Distinct CNR specimens linked"),
n = c(
n_referred,
n_distinct(bhre_keyed$ehesp_id),
n_distinct(best_matches$ehesp_id),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "High"]),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "Medium"]),
n_distinct(best_matches$ehesp_id[best_matches$confidence == "Low"]),
n_distinct(best_matches$ehesp_id[best_matches$n_tied_at_top > 1]),
n_distinct(best_matches$specimen_id)
)
)
print(link_summary)
# Inspect: candidates (all scored pairs) | best_matches (one per episode)
View(best_matches)
View(bhre_no_family)
